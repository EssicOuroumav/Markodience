# Copier vers .env.local et remplir. Ne jamais committer .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Paiement PayDunya (serveur uniquement) : app.paydunya.com > Intégrer > Clés API
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=sandbox
# URL publique de l'application (callback du paiement et redirections)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DEV UNIQUEMENT (jamais en production) : AI_MOCK=1 et PAYMENTS_MOCK=1
# Suivi d'erreurs Sentry (facultatif) : adresse DSN du projet Next.js, sentry.io > Settings > Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Routage des modèles d'IA (facultatif) : AI_MODEL force un modèle pour toutes les tâches ;
# AI_MODEL_LIGHT (tonalité, lives, une semaine) et AI_MODEL_HEAVY (identité, piliers, ligne éditoriale, audit d'images) changent un palier.
# Par défaut : light = claude-haiku-4-5, heavy = claude-sonnet-5-5.
AI_MODEL=
AI_MODEL_LIGHT=
AI_MODEL_HEAVY=
# Rappels par e-mail (facultatif) : clé API Resend et expéditeur vérifié (« Markodience <rappels@votre-domaine> »).
# CRON_SECRET : mot de passe de la tâche planifiée (Vercel l'envoie tout seul quand la variable existe) ; sans lui, la route répond 503.
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=

